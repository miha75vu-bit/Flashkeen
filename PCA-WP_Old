write_guard() {
    cat > "$GUARD" <<'GUARD'
#!/usr/bin/env bash
set -Eeuo pipefail
WG_CONF="/etc/wireguard/wg0.conf"
TPROXY_PORT="61245"
TPROXY_MARK="1"
VPN_NET_DEFAULT="10.25.0.0/16"
WARP_STATE="/etc/phobos-exit-warp.env"
WARP_TABLE="51820"
WARP_MARK="255"

vpn_net() {
    local cidr
    cidr="$(awk -F= 'BEGIN{IGNORECASE=1} /^[[:space:]]*Address/{gsub(/[[:space:]]/,"",$2); split($2,a,","); print a[1]; exit}' "$WG_CONF" 2>/dev/null || true)"
    if [[ -z "$cidr" ]]; then
        echo "$VPN_NET_DEFAULT"
        return 0
    fi
    python3 - "$cidr" <<'PY' || echo "$VPN_NET_DEFAULT"
import sys, ipaddress
print(ipaddress.ip_interface(sys.argv[1].strip()).network)
PY
}

public_iface() {
    ip -4 route show default 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}'
}

has_warp_fwmark_rule() {
    local rules
    rules="$(ip rule show 2>/dev/null || true)"
    grep -Eq "fwmark (0xff|0xFF|255)(/[^ ]*)? (lookup|table) ${WARP_TABLE}" <<<"$rules"
}

heal_warp_from_state() {
    [[ -f "$WARP_STATE" ]] || return 0
    # shellcheck disable=SC1090
    . "$WARP_STATE"
    [[ "${WARP_OK:-0}" == "1" ]] || return 0
    local dev="${WARP_DEV:-}"
    [[ -n "$dev" ]] || return 0
    ip link show "$dev" >/dev/null 2>&1 || return 0
    local i
    for ((i = 0; i < 8; i++)); do
        ip rule del fwmark "$WARP_MARK" lookup "$WARP_TABLE" 2>/dev/null || true
        ip rule del fwmark "$WARP_MARK" table "$WARP_TABLE" 2>/dev/null || true
        has_warp_fwmark_rule || break
    done
    ip route replace default dev "$dev" table "$WARP_TABLE"
    ip rule add fwmark "$WARP_MARK" lookup "$WARP_TABLE" priority 100
    has_warp_fwmark_rule
}

drop_open_nat() {
    local net="$1" rule
    while read -r rule; do
        [[ "$rule" == "-A POSTROUTING "* ]] || continue
        [[ "$rule" == *" -j MASQUERADE"* || "$rule" == *" -j SNAT"* ]] || continue
        if [[ "$rule" != *" -s "* && "$rule" != *" -d "* && "$rule" == *" -j MASQUERADE"* ]]; then
            iptables -t nat ${rule/-A /-D }
            continue
        fi
        if [[ "$rule" == *" -s ${net} "* ]]; then
            iptables -t nat ${rule/-A /-D }
        fi
    done < <(iptables -t nat -S POSTROUTING 2>/dev/null || true)
}

apply_sysctl() {
    sysctl -qw net.ipv4.ip_forward=1
    sysctl -qw net.ipv4.conf.all.accept_source_route=0 || true
    sysctl -qw net.ipv4.conf.default.accept_source_route=0 || true
    sysctl -qw net.ipv4.conf.all.send_redirects=0 || true
    sysctl -qw net.ipv4.conf.default.send_redirects=0 || true
    sysctl -qw net.ipv4.conf.all.accept_redirects=0 || true
    sysctl -qw net.ipv6.conf.all.forwarding=0 || true
    local scope cur
    for scope in all default wg0; do
        [[ -e "/proc/sys/net/ipv4/conf/${scope}/rp_filter" ]] || continue
        cur="$(cat "/proc/sys/net/ipv4/conf/${scope}/rp_filter" 2>/dev/null || true)"
        if [[ "$cur" == "1" ]]; then
            sysctl -qw "net.ipv4.conf.${scope}.rp_filter=2" || true
        fi
    done
}

apply_forward() {
    local net="$1"
    iptables -N PHOBOS_FWD 2>/dev/null || true
    iptables -F PHOBOS_FWD
    iptables -A PHOBOS_FWD -d "$net" -j ACCEPT
    iptables -A PHOBOS_FWD -p udp --dport 443 -j REJECT --reject-with icmp-port-unreachable
    iptables -A PHOBOS_FWD -j REJECT
    while iptables -D FORWARD -i wg0 -j PHOBOS_FWD 2>/dev/null; do :; done
    iptables -I FORWARD 1 -i wg0 -j PHOBOS_FWD
    while iptables -D FORWARD -i wg0 -j ACCEPT 2>/dev/null; do :; done
    while iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; do :; done
}

apply_ipv6() {
    command -v ip6tables >/dev/null 2>&1 || return 0
    ip6tables -N PHOBOS_FWD6 2>/dev/null || true
    ip6tables -F PHOBOS_FWD6
    ip6tables -A PHOBOS_FWD6 -j REJECT --reject-with icmp6-addr-unreachable
    while ip6tables -D FORWARD -i wg0 -j PHOBOS_FWD6 2>/dev/null; do :; done
    ip6tables -I FORWARD 1 -i wg0 -j PHOBOS_FWD6
}

apply_input() {
    local pub
    pub="$(public_iface || true)"
    iptables -N PHOBOS_IN 2>/dev/null || true
    iptables -F PHOBOS_IN
    iptables -A PHOBOS_IN -p tcp --dport 1080 -j REJECT
    iptables -A PHOBOS_IN -p udp --dport 1080 -j REJECT
    iptables -A PHOBOS_IN -d 172.16.0.0/12 -j REJECT
    iptables -A PHOBOS_IN -j RETURN
    while iptables -D INPUT -i wg0 -j PHOBOS_IN 2>/dev/null; do :; done
    iptables -I INPUT 1 -i wg0 -j PHOBOS_IN
    if [[ -n "$pub" ]]; then
        while iptables -D INPUT -i "$pub" -p tcp --dport 1080 -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$pub" -p udp --dport 1080 -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$pub" -p tcp --dport 5353 -j DROP 2>/dev/null; do :; done
        while iptables -D INPUT -i "$pub" -p udp --dport 5353 -j DROP 2>/dev/null; do :; done
        iptables -I INPUT 1 -i "$pub" -p tcp --dport 1080 -j DROP
        iptables -I INPUT 1 -i "$pub" -p udp --dport 1080 -j DROP
        iptables -I INPUT 1 -i "$pub" -p tcp --dport 5353 -j DROP
        iptables -I INPUT 1 -i "$pub" -p udp --dport 5353 -j DROP
    fi
}

apply_dns() {
    # mangle срабатывает раньше nat, поэтому DNS сначала возвращаем из TPROXY,
    # и только потом REDIRECT забирает порт 53 на локальный фильтр.
    iptables -t nat -N PHOBOS_DNS 2>/dev/null || true
    iptables -t nat -F PHOBOS_DNS
    iptables -t nat -A PHOBOS_DNS -p udp --dport 53 -j REDIRECT --to-ports 5353
    iptables -t nat -A PHOBOS_DNS -p tcp --dport 53 -j REDIRECT --to-ports 5353
    while iptables -t nat -D PREROUTING -i wg0 -j PHOBOS_DNS 2>/dev/null; do :; done
    iptables -t nat -I PREROUTING 1 -i wg0 -j PHOBOS_DNS
}

apply_tproxy() {
    local net="$1"
    modprobe xt_TPROXY 2>/dev/null || true
    ip rule del fwmark "$TPROXY_MARK" lookup 100 priority 50 2>/dev/null || true
    ip rule add fwmark "$TPROXY_MARK" lookup 100 priority 50
    # Метка 2 — выход Psiphon/direct в основную таблицу, не в TPROXY и не в WARP.
    ip rule del fwmark 2 lookup main priority 40 2>/dev/null || true
    ip rule add fwmark 2 lookup main priority 40
    ip route replace local 0.0.0.0/0 dev lo table 100
    iptables -t mangle -N PHOBOS_PRE 2>/dev/null || true
    iptables -t mangle -F PHOBOS_PRE
    iptables -t mangle -A PHOBOS_PRE -d "$net" -j RETURN
    iptables -t mangle -A PHOBOS_PRE -d 127.0.0.0/8 -j RETURN
    iptables -t mangle -A PHOBOS_PRE -m addrtype --dst-type LOCAL -j RETURN
    # Крупные ответы не должны застревать на MTU туннеля.
    iptables -t mangle -A PHOBOS_PRE -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1240
    # QUIC (UDP/443) не отдаём в Xray: silent blackhole не даёт браузеру
    # перейти на TCP, и Psiphon не видит Gemini. ICMP port-unreachable
    # приходит из PHOBOS_FWD, дальше идёт обычный HTTPS.
    iptables -t mangle -A PHOBOS_PRE -p udp --dport 443 -j RETURN
    iptables -t mangle -A PHOBOS_PRE -p udp --dport 53 -j RETURN
    iptables -t mangle -A PHOBOS_PRE -p tcp --dport 53 -j RETURN
    iptables -t mangle -A PHOBOS_PRE -p tcp -j TPROXY --on-port "$TPROXY_PORT" --on-ip 127.0.0.1 --tproxy-mark "$TPROXY_MARK"
    iptables -t mangle -A PHOBOS_PRE -p udp -j TPROXY --on-port "$TPROXY_PORT" --on-ip 127.0.0.1 --tproxy-mark "$TPROXY_MARK"
    while iptables -t mangle -D PREROUTING -i wg0 -j PHOBOS_PRE 2>/dev/null; do :; done
    iptables -t mangle -I PREROUTING 1 -i wg0 -j PHOBOS_PRE
}

flush_client_conntrack() {
    local net="$1"
    command -v conntrack >/dev/null 2>&1 || return 0
    conntrack -D -s "$net" >/dev/null 2>&1 || true
}

cmd_apply() {
    ip link show wg0 >/dev/null 2>&1 || exit 0
    local net
    net="$(vpn_net)"
    apply_sysctl
    apply_forward "$net"
    drop_open_nat "$net"
    apply_ipv6
    apply_input
    apply_dns
    apply_tproxy "$net"
    heal_warp_from_state || true
    flush_client_conntrack "$net"
}

cmd_down() {
    while iptables -t nat -D PREROUTING -i wg0 -j PHOBOS_DNS 2>/dev/null; do :; done
    iptables -t nat -F PHOBOS_DNS 2>/dev/null || true
    iptables -t nat -X PHOBOS_DNS 2>/dev/null || true
    while iptables -t mangle -D PREROUTING -i wg0 -j PHOBOS_PRE 2>/dev/null; do :; done
    iptables -t mangle -F PHOBOS_PRE 2>/dev/null || true
    iptables -t mangle -X PHOBOS_PRE 2>/dev/null || true
    ip rule del fwmark "$TPROXY_MARK" lookup 100 priority 50 2>/dev/null || true
}

case "${1:-apply}" in
    apply) cmd_apply ;;
    down) cmd_down ;;
    *) echo "usage: $0 apply|down" >&2; exit 2 ;;
esac
GUARD
    chmod 755 "$GUARD"

    mkdir -p /etc/systemd/system/wg-quick@wg0.service.d
    cat > /etc/systemd/system/wg-quick@wg0.service.d/exit-guard.conf <<'EOF'
[Service]
ExecStartPost=/usr/local/sbin/phobos-exit-guard.sh apply
ExecStopPost=/usr/local/sbin/phobos-exit-guard.sh down
EOF

    cat > /etc/systemd/system/phobos-exit-guard.service <<'EOF'
[Unit]
Description=Phobos client egress lock
After=wg-quick@wg0.service
Requires=wg-quick@wg0.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/phobos-exit-guard.sh apply
ExecStop=/usr/local/sbin/phobos-exit-guard.sh down

[Install]
WantedBy=multi-user.target
EOF

    cat > /etc/sysctl.d/99-phobos-exit.conf <<'EOF'
net.ipv4.ip_forward = 1
net.ipv4.conf.all.rp_filter = 2
net.ipv4.conf.default.rp_filter = 2
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.forwarding = 0
EOF
    sysctl --system >/dev/null 2>&1 || true
}

patch_wg0() {
