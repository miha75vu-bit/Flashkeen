    pass="$(python3 - "$PANEL_DIR/settings.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8")).get("admin_pass", ""))
PY
)"
    apikey="$(python3 - "$PANEL_DIR/settings.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8")).get("server_api_key", ""))
PY
)"
    echo "------------------------------------------------------------"
    echo -e "  Адрес : ${CYAN}http://${ip}:${port}${RESET}"
    echo -e "  Логин : ${GREEN}admin${RESET}"
    if [[ -n "$pass" ]]; then
        echo -e "  Пароль: ${GREEN}${pass}${RESET}"
    else
        echo -e "  Пароль: ${YELLOW}не прочитан из settings.json${RESET}"
