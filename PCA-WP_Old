# Порт 53 перехватывается раньше Xray (фильтр без IPv6). Это правило — запасное:
# если пакет всё же дошёл, 8.8.8.8 не должен попасть в блок и не в Psiphon.
# Дальше Google по IP: имя в TLS часто скрыто, и без IP правило запрос уходит в WARP.
google_ips = [
    "geoip:google",
    "8.8.8.8/32",
    "8.8.4.4/32",
    "64.233.160.0/19",
    "66.102.0.0/20",
    "66.249.80.0/20",
    "72.14.192.0/18",
    "74.125.0.0/16",
    "108.177.8.0/21",
    "108.177.64.0/19",
    "108.177.96.0/19",
    "142.250.0.0/15",
    "172.217.0.0/16",
    "172.253.0.0/16",
    "173.194.0.0/16",
    "209.85.128.0/17",
    "216.58.192.0/19",
    "216.239.32.0/19",
]
rules = [
    {"type": "field", "port": "53", "network": "tcp,udp", "outboundTag": plain_egress},
    {"type": "field", "ip": google_ips, "outboundTag": service_out},
    {"type": "field", "domain": services, "network": "tcp", "outboundTag": service_out},
    {"type": "field", "domain": services, "network": "udp", "outboundTag": "blocked"},
]
rules.append({"type": "field", "ip": ru_ips, "outboundTag": "blocked"})
rules.append({"type": "field", "domain": ru_sites, "outboundTag": "blocked"})
if dat_has("geosite.dat", "category-ip-geo-detect"):
    rules.append({"type": "field", "domain": ["geosite:category-ip-geo-detect"], "outboundTag": "blocked"})
rules.append({"type": "field", "domain": ru_services, "outboundTag": "blocked"})
rules.append({"type": "field", "ip": ["geoip:private"], "outboundTag": "blocked"})
rules.append({"type": "field", "protocol": ["bittorrent"], "outboundTag": "blocked"})
rules.append({"type": "field", "network": "tcp,udp", "outboundTag": catch_all})

cfg = {
    "log": {"loglevel": "warning"},
    "inbounds": [{
        "listen": "127.0.0.1",
        "port": int(tport),
        "protocol": "dokodemo-door",
        "tag": "tproxy-in",
        "settings": {"network": "tcp,udp", "followRedirect": True},
        "sniffing": {
            "enabled": True,
            "destOverride": ["http", "tls", "quic"],
            "metadataOnly": False,
            "routeOnly": True,
        },
        "streamSettings": {"sockopt": {"tproxy": "tproxy"}},
    }],
    "outbounds": outbounds,
    "routing": {"domainStrategy": "AsIs", "rules": rules},
}

if cfg["outbounds"][0]["tag"] != "blocked":
    raise SystemExit("default outbound must be blocked")
tags = [x["tag"] for x in cfg["outbounds"]]
if warp_on:
    warp = next(x for x in cfg["outbounds"] if x["tag"] == "warp-out")
    if warp["streamSettings"]["sockopt"].get("mark") != 255:
        raise SystemExit("warp-out has no mark 255")
if use_psiphon and "psiphon-out" not in tags:
    raise SystemExit("psiphon-out missing")
if "dns" in cfg:
    raise SystemExit("dns block is not allowed")
if rules[-1]["outboundTag"] != catch_all:
    raise SystemExit("catch-all mismatch")

with open(out_path, "w", encoding="utf-8") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2)
    f.write("\n")
print(out_path)
PY
