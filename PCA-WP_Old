#!/usr/bin/env bash
# PCA Phobos: WARP на все выходы, RU в blackhole, Google/Gemini/OpenAI/Anthropic через Psiphon.
# Клиенты приходят в WireGuard wg0. Наружу их пакеты не форвардятся:
# PREROUTING TPROXY -> Xray -> psiphon-out | warp-out (fwmark 255) | blackhole.
set -Eeuo pipefail

export DEBIAN_FRONTEND=noninteractive
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

BASE="/root/warp-psiphon-setup"
WG_CONF="/etc/wireguard/wg0.conf"
PANEL_DIR="/opt/phobos-panel"
PANEL_UNIT="phobos-panel"
XRAY_BIN="/usr/local/bin/xray"
XRAY_ASSET="/usr/local/share/xray"
XRAY_CFG="/usr/local/etc/xray/phobos-exit.json"
XRAY_UNIT="phobos-xray"
GUARD="/usr/local/sbin/phobos-exit-guard.sh"
TPROXY_PORT="61245"
DNS_FILTER_PORT="5353"
WARP_TABLE="51820"
WARP_MARK="255"
TPROXY_MARK="1"
VPN_NET_DEFAULT="10.25.0.0/16"

USE_PSIPHON=1
PSIPHON_PORT="1080"
PSIPHON_SOCKS="172.17.0.1:1080"
PSIPHON_REGION="AUTO"

WARP_BACKEND="none"
WARP_DEV=""
WARP_OK=0
ORIG_DEFAULT=""
WARP_STATE="/etc/phobos-exit-warp.env"

VPS_WARP_INSTALL_URL="https://raw.githubusercontent.com/tagashi666/vps-warp/main/warp_install.sh"
PSIPHON_INSTALL_URL="https://raw.githubusercontent.com/Chara-Freedom/vps-psiphon/main/psiphon_install.sh"
PHOBOS_INSTALL_URL="https://raw.githubusercontent.com/andrey271192/PCA_Phobos/main/install.sh"
XRAY_INSTALL_URL="https://github.com/XTLS/Xray-install/raw/main/install-release.sh"
GEO_BASE="https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download"

mkdir -p "$BASE" "$BASE/backup"
chmod 700 "$BASE"

LOG="$BASE/setup.log"
exec > >(tee -a "$LOG") 2>&1

GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
CYAN="\033[1;36m"
RESET="\033[0m"

ok()   { echo -e "${GREEN}[OK]${RESET} $*"; }
warn() { echo -e "${YELLOW}[WARN]${RESET} $*"; }
die()  { echo -e "${RED}[ОШИБКА]${RESET} $*"; exit 1; }
info() { echo -e "${CYAN}$*${RESET}"; }

section() {
    echo
    echo "============================================================"
    echo "$*"
    echo "============================================================"
    echo
}

public_iface() {
    ip -4 route show default 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}'
}

vpn_net() {
    local cidr
    cidr="$(awk -F= 'BEGIN{IGNORECASE=1} /^[[:space:]]*Address/{gsub(/[[:space:]]/,"",$2); split($2,a,","); print a[1]; exit}' "$WG_CONF" 2>/dev/null || true)"
    if [[ -z "$cidr" ]]; then
        echo "$VPN_NET_DEFAULT"
        return 0
    fi
    python3 - "$cidr" <<'PY' || echo "$VPN_NET_DEFAULT"
import sys, ipaddress
print(ipaddress.ip_interface(sys.argv[1].strip()).network)
PY
}

drop_open_nat() {
    local net="$1"
    local rule
    while read -r rule; do
        [[ "$rule" == "-A POSTROUTING "* ]] || continue
        [[ "$rule" == *" -j MASQUERADE"* || "$rule" == *" -j SNAT"* ]] || continue
        if [[ "$rule" != *" -s "* && "$rule" != *" -d "* && "$rule" == *" -j MASQUERADE"* ]]; then
            iptables -t nat ${rule/-A /-D }
            continue
        fi
        if [[ "$rule" == *" -s ${net} "* ]]; then
            iptables -t nat ${rule/-A /-D }
        fi
    done < <(iptables -t nat -S POSTROUTING 2>/dev/null || true)
}

# Закрыть прямой форвард клиентов сразу, ещё до WARP/Xray.
lock_client_egress() {
    local net
    ip link show wg0 >/dev/null 2>&1 || return 0
    net="$(vpn_net)"
    iptables -N PHOBOS_FWD 2>/dev/null || true
    iptables -F PHOBOS_FWD
    iptables -A PHOBOS_FWD -d "$net" -j ACCEPT
    iptables -A PHOBOS_FWD -j REJECT
    while iptables -D FORWARD -i wg0 -j PHOBOS_FWD 2>/dev/null; do :; done
    iptables -I FORWARD 1 -i wg0 -j PHOBOS_FWD
    while iptables -D FORWARD -i wg0 -j ACCEPT 2>/dev/null; do :; done
    while iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; do :; done
    drop_open_nat "$net"
    if ! command -v conntrack >/dev/null 2>&1; then
        apt-get install -y conntrack >/dev/null 2>&1 || true
    fi
    if command -v conntrack >/dev/null 2>&1; then
        conntrack -D -s "$net" >/dev/null 2>&1 || true
    fi
    if command -v ip6tables >/dev/null 2>&1; then
        ip6tables -N PHOBOS_FWD6 2>/dev/null || true
        ip6tables -F PHOBOS_FWD6
        ip6tables -A PHOBOS_FWD6 -j REJECT --reject-with icmp6-addr-unreachable
        while ip6tables -D FORWARD -i wg0 -j PHOBOS_FWD6 2>/dev/null; do :; done
        ip6tables -I FORWARD 1 -i wg0 -j PHOBOS_FWD6
    fi
    ok "Прямой выход wg0 закрыт (разрешён только ${net})"
}

# Уже выданные конфиги телефонов и роутеров часто содержат только 0.0.0.0/0.
# Тогда IPv6 Google идёт напрямую у провайдера и страница пишет «не поддерживается в вашей стране».
pin_client_full_tunnel() {
    python3 <<'PY'
import re
from pathlib import Path

changed = []
roots = [Path("/opt/Phobos"), Path("/opt/phobos-panel")]
seen = set()
files = []
for root in roots:
    if not root.is_dir():
        continue
    for conf in root.rglob("*"):
        if not conf.is_file() or conf in seen:
            continue
        if conf.suffix.lower() not in {".conf", ".txt", ".template"} and conf.name != "app.py":
            continue
        seen.add(conf)
        files.append(conf)

v6_block = re.compile(
    r'(?P<ind>[ \t]*)if "0\.0\.0\.0/0" not in parts:\n'
    r'(?P=ind)(?P<pad>[ \t]+)parts\.insert\(0, "0\.0\.0\.0/0"\)'
)

for conf in files:
    try:
        text = conf.read_text(encoding="utf-8", errors="replace")
    except OSError:
        continue
    if "AllowedIPs" not in text and conf.name != "app.py":
        continue
    orig = text
    if conf.name == "app.py":
        if 'if "::/0" not in parts:' not in text:
            def _add_v6(match):
                ind = match.group("ind")
                pad = match.group("pad")
                return (
                    match.group(0)
                    + "\n"
                    + f'{ind}if "::/0" not in parts:\n'
                    + f'{ind}{pad}parts.append("::/0")'
                )
            text, _ = v6_block.subn(_add_v6, text, count=1)
    else:
        lines = []
        for ln in text.splitlines(keepends=True):
            stripped = ln.strip()
            if stripped.lower().startswith("allowedips") and "=" in stripped:
                nl = "\n" if ln.endswith("\n") else ""
                key, _, val = stripped.partition("=")
                parts = [p.strip() for p in val.split(",") if p.strip()]
                if "0.0.0.0/0" not in parts:
                    parts.insert(0, "0.0.0.0/0")
                if "::/0" not in parts:
                    parts.append("::/0")
                ln = f"{key.strip()} = {', '.join(parts)}{nl}"
            lines.append(ln)
        text = "".join(lines)
    if text != orig:
        if conf.name == "app.py":
            try:
                compile(text, str(conf), "exec")
            except SyntaxError:
                continue
        conf.write_text(text, encoding="utf-8", newline="\n")
        changed.append(str(conf))
print(len(changed))
PY
}

remember_default_route() {
    ORIG_DEFAULT="$(ip -4 route show default 2>/dev/null | head -n1 || true)"
}

restore_public_default() {
    local dev
    dev="$(public_iface || true)"
    if [[ -n "$dev" && "$dev" != "warp" ]]; then
        return 0
    fi
    [[ -n "$ORIG_DEFAULT" ]] || die "Пропал публичный default route"
    ip route replace $ORIG_DEFAULT
    dev="$(public_iface || true)"
    [[ -n "$dev" && "$dev" != "warp" ]] || die "Публичный default route не восстановлен"
    ok "Основной default оставлен на ${dev}"
}

drop_unmarked_warp_rules() {
    local pri rest
    while read -r pri rest; do
        [[ -n "$pri" ]] || continue
        pri="${pri%:}"
        if [[ "$rest" == *"lookup ${WARP_TABLE}"* && "$rest" != *"fwmark"* ]]; then
            ip rule del priority "$pri" 2>/dev/null || true
            warn "Удалено правило, которое гнало весь трафик сервера в WARP (priority ${pri})"
        fi
    done < <(ip rule show 2>/dev/null || true)
}

has_warp_fwmark_rule() {
    local rules
    rules="$(ip rule show 2>/dev/null || true)"
    # iproute2 обычно печатает "fwmark 0xff lookup 51820"
    grep -Eq "fwmark (0xff|0xFF|255)(/[^ ]*)? (lookup|table) ${WARP_TABLE}" <<<"$rules"
}

purge_warp_fwmark_rules() {
    local i
    for ((i = 0; i < 12; i++)); do
        ip rule del fwmark "$WARP_MARK" lookup "$WARP_TABLE" 2>/dev/null || true
        ip rule del fwmark "$WARP_MARK" table "$WARP_TABLE" 2>/dev/null || true
        ip rule del fwmark 0xff lookup "$WARP_TABLE" 2>/dev/null || true
        ip rule del fwmark 0xff table "$WARP_TABLE" 2>/dev/null || true
        has_warp_fwmark_rule || return 0
    done
}

save_warp_state() {
    umask 077
    cat > "$WARP_STATE" <<EOF
WARP_BACKEND=${WARP_BACKEND}
WARP_DEV=${WARP_DEV}
WARP_OK=${WARP_OK}
WARP_TABLE=${WARP_TABLE}
WARP_MARK=${WARP_MARK}
EOF
}

# --- WARP ---

get_active_normal_warp() {
    local trace
    ip link show warp >/dev/null 2>&1 || return 1
    trace="$(curl -4fsS --interface warp --max-time 6 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)"
    grep -q 'warp=' <<<"$trace" || return 1
    echo "warp"
}


heal_policy_routing() {
    local dev="$1"
    [[ -n "$dev" ]] || die "heal_policy_routing: пустой интерфейс WARP"
    ip link show "$dev" >/dev/null 2>&1 || die "Интерфейс WARP ${dev} не найден"
    # fwmark 255 -> table 51820; чужой PostDown мог снять правило — восстанавливаем.
    purge_warp_fwmark_rules
    ip route replace default dev "$dev" table "$WARP_TABLE"
    ip rule add fwmark "$WARP_MARK" lookup "$WARP_TABLE" priority 100
    drop_unmarked_warp_rules
    restore_public_default
    has_warp_fwmark_rule || die "Не удалось создать ip rule fwmark ${WARP_MARK} -> table ${WARP_TABLE}"
    ip route show table "$WARP_TABLE" | grep -q "^default" || die "В таблице ${WARP_TABLE} нет default через ${dev}"
    WARP_DEV="$dev"
    save_warp_state
    ok "Маршрутизация (fwmark ${WARP_MARK} -> table ${WARP_TABLE} -> ${dev}) активна, default сервера не тронут"
}

cleanup_firewall_rules() {
    iptables -D OUTPUT -m mark ! --mark 255 -p tcp -j REJECT >/dev/null 2>&1 || true
    iptables -D OUTPUT -m mark ! --mark 255 -p udp -j REJECT >/dev/null 2>&1 || true
}

cleanup_normal_warp() {
    section "ОЧИСТКА ОБЫЧНОГО WARP"
    if command -v vps-warp >/dev/null 2>&1; then
        vps-warp off >/dev/null 2>&1 || true
    fi
    systemctl stop wg-quick@warp >/dev/null 2>&1 || true
    systemctl disable wg-quick@warp >/dev/null 2>&1 || true
    ip link del warp >/dev/null 2>&1 || true
    ip route del default dev warp table "$WARP_TABLE" >/dev/null 2>&1 || true
    ok "Обычный WARP отключен"
}

purge_legacy_awg_warp() {
    # Старые установки резервного AWG больше не поддерживаются — убираем остатки.
    local srv awg_links iface
    for srv in $(systemctl list-unit-files 'awg-quick@*' --no-legend 2>/dev/null | awk '{print $1}' || true); do
        systemctl disable --now "$srv" >/dev/null 2>&1 || true
    done
    awg_links="$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^awgo-' || true)"
    for iface in $awg_links; do
        awg-quick down "$iface" >/dev/null 2>&1 || true
        ip link del "$iface" >/dev/null 2>&1 || true
        ip route del default dev "$iface" table "$WARP_TABLE" >/dev/null 2>&1 || true
    done
    rm -f /etc/amnezia/amneziawg/awgo-*.conf 2>/dev/null || true
}

install_minimal() {
    section "1/7 ПОДГОТОВКА СИСТЕМЫ"
    apt-get update -y >/dev/null 2>&1
    apt-get install -y curl ca-certificates >/dev/null 2>&1
    ok "Базовые пакеты проверены"
}

install_phobos() {
    section "УСТАНОВКА PCA PHOBOS"
    if [[ -f "$PANEL_DIR/app.py" && -f "$WG_CONF" ]] && systemctl cat "$PANEL_UNIT" >/dev/null 2>&1; then
        ok "PCA Phobos уже установлен — пропускаем"
        return 0
    fi
    info "Ставим PCA Phobos (WireGuard + панель)..."
    local installer="$BASE/phobos-install.sh"
    curl -fL --connect-timeout 20 --max-time 180 "$PHOBOS_INSTALL_URL" -o "$installer" || die "Не удалось скачать установщик PCA Phobos"
    bash "$installer" || die "Установщик PCA Phobos завершился с ошибкой"
    [[ -f "$PANEL_DIR/app.py" && -f "$WG_CONF" ]] || die "PCA Phobos не установлен"
    ok "PCA Phobos установлен"
}

install_dependencies() {
    section "ЗАВИСИМОСТИ"
    apt-get update -y >/dev/null 2>&1
    apt-get install -y \
        jq sqlite3 iproute2 iptables \
        wireguard-tools unzip xz-utils socat procps \
        net-tools curl ca-certificates python3 coreutils openssl psmisc conntrack \
        gpg >/dev/null 2>&1

    if ! command -v docker >/dev/null 2>&1; then
        curl -fsSL https://get.docker.com | sh
    fi
    systemctl enable --now docker >/dev/null 2>&1 || true
    ok "Зависимости готовы"
}

install_normal_warp() {
    section "УСТАНОВКА ОБЫЧНОГО WARP"
    if get_active_normal_warp >/dev/null; then
        ok "Существующий WARP уже работает — переустановка не нужна"
        vps-warp status 2>/dev/null || true
        heal_policy_routing "warp"
        return 0
    fi

    info "Скачиваем и запускаем установщик vps-warp..."
    local installer="$BASE/warp_install.sh"
    if ! curl -fL --connect-timeout 10 --max-time 30 "$VPS_WARP_INSTALL_URL" -o "$installer"; then
        warn "Не удалось скачать установщик vps-warp"
        return 1
    fi
    chmod +x "$installer"
    if ! bash "$installer"; then
        warn "Установщик vps-warp завершился с ошибкой"
        restore_public_default || true
        return 1
    fi

    local i
    for ((i = 1; i <= 20; i++)); do
        echo "    WARP: $i/20 сек..."
        if get_active_normal_warp >/dev/null; then
            ok "Обычный WARP подключен"
            heal_policy_routing "warp"
            vps-warp status 2>/dev/null || true
            return 0
        fi
        sleep 1
    done
    restore_public_default || true
    return 1
}


manage_warp() {
    section "УПРАВЛЕНИЕ И ВЫБОР РЕЖИМА WARP"
    local active_normal="" choice=""
    purge_legacy_awg_warp
    active_normal="$(get_active_normal_warp || true)"

    echo "Текущий статус туннеля WARP на сервере:"
    if [[ -n "$active_normal" ]]; then
        ok "Обнаружен активный [Обычный WARP] (интерфейс: $active_normal)"
    else
        warn "Активный рабочий туннель WARP не найден"
    fi
    echo

    if [[ -n "$active_normal" ]]; then
        echo "0) Оставить текущий рабочий WARP (восстановит маршруты без переустановки)"
        echo "1) Переустановить Обычный WARP (vps-warp)"
        echo "2) Отключить WARP (весь прочий трафик будет заблокирован)"
        echo
        read -rp "Выберите действие [0/1/2, Enter=0]: " choice
        choice="${choice:-0}"
    else
        echo "1) Установить Обычный WARP (vps-warp)"
        echo "0) Пропустить настройку WARP (без WARP весь прочий трафик будет заблокирован)"
        echo
        read -rp "Выберите действие [1/0, Enter=1]: " choice
        choice="${choice:-1}"
    fi

    case "$choice" in
        0)
            if [[ -n "$active_normal" ]]; then
                ok "Сохраняем текущий Обычный WARP ($active_normal)"
                WARP_BACKEND="normal"
                WARP_OK=1
                heal_policy_routing "$active_normal"
            else
                info "Работа продолжится без WARP: весь трафик кроме Psiphon/direct будет заблокирован"
                WARP_BACKEND="none"
                WARP_DEV=""
                WARP_OK=0
                save_warp_state
            fi
            ;;
        1)
            if install_normal_warp; then
                WARP_BACKEND="normal"
                WARP_OK=1
                heal_policy_routing "warp"
            else
                die "Не удалось запустить Обычный WARP"
            fi
            ;;
        2)
            if [[ -z "$active_normal" ]]; then
                die "Неизвестный пункт. Выход без открытия прямого канала."
            fi
            cleanup_normal_warp
            WARP_BACKEND="none"
            WARP_DEV=""
            WARP_OK=0
            save_warp_state
            ok "WARP отключен"
            ;;
        *)
            die "Неизвестный пункт. Выход без открытия прямого канала."
            ;;
    esac
    restore_public_default
    if [[ "$WARP_OK" == "1" ]]; then
        [[ -n "$WARP_DEV" ]] || WARP_DEV="$(get_active_normal_warp || true)"
        heal_policy_routing "$WARP_DEV"
    fi
}

# --- PSIPHON ---

psiphon_local_listener() {
    ss -lntp 2>/dev/null | awk -v port=":$PSIPHON_PORT" 'NR > 1 && $1 == "LISTEN" && index($4, port) > 0 { print $4; exit }'
}

psiphon_local_addr() {
    awk '{ x=$0; sub(/:[0-9]+$/, "", x); gsub(/^\[|\]$/, "", x); print x }' <<<"$1"
}

refresh_psiphon_socks() {
    local gw
    gw="$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}' vps-psiphon 2>/dev/null || true)"
    if [[ "$gw" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        PSIPHON_SOCKS="${gw}:${PSIPHON_PORT}"
    fi
}

get_active_psiphon_trace() {
    local listener addr trace
    listener="$(psiphon_local_listener)"
    [[ -n "$listener" ]] || return 1
    addr="$(psiphon_local_addr "$listener")"
    case "$addr" in
        0.0.0.0|::|"") return 1 ;;
    esac
    refresh_psiphon_socks
    trace="$(timeout 10 curl -4fsS --proxy "socks5h://${PSIPHON_SOCKS}" --max-time 8 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)"
    if grep -q 'ip=' <<<"$trace"; then
        echo "$trace"
        return 0
    fi
    return 1
}

choose_psiphon_region() {
    echo "Выберите регион выхода Psiphon:"
    echo "  AUTO — автоматически (рекомендуется)"
    echo "  DE  NL  FI  SE  FR  GB  US  CA"
    echo
    read -rp "Регион [AUTO]: " PSIPHON_REGION
    PSIPHON_REGION="${PSIPHON_REGION:-AUTO}"
    PSIPHON_REGION="$(echo "$PSIPHON_REGION" | tr -d ' ')"
}

install_psiphon_core() {
    choose_psiphon_region
    echo "Устанавливаем / перезапускаем Psiphon..."
    local psiphon_args=("--socks-port" "$PSIPHON_PORT" "--no-http")
    if [[ "${PSIPHON_REGION^^}" != "AUTO" ]]; then
        psiphon_args+=("--region" "${PSIPHON_REGION^^}")
    fi
    docker rm -f vps-psiphon >/dev/null 2>&1 || true
    if ! timeout 150 bash <(curl -fsSL "$PSIPHON_INSTALL_URL") "${psiphon_args[@]}"; then
        warn "Установка Psiphon завершилась ошибкой"
        return 1
    fi
    refresh_psiphon_socks
    local i
    for ((i = 1; i <= 25; i++)); do
        echo "    Psiphon: $i/25 сек..."
        if get_active_psiphon_trace >/dev/null; then
            ok "Psiphon HTTPS работает (${PSIPHON_SOCKS})"
            return 0
        fi
        sleep 1
    done
    return 1
}

disable_psiphon() {
    # Полностью гасим контейнер, а не только отвязываем от Xray/Phobos.
    local unit c
    for unit in $(systemctl list-unit-files '*psiphon*' --no-legend 2>/dev/null | awk '{print $1}' || true); do
        systemctl disable --now "$unit" >/dev/null 2>&1 || true
    done
    if command -v docker >/dev/null 2>&1; then
        docker update --restart=no vps-psiphon >/dev/null 2>&1 || true
        docker rm -f vps-psiphon >/dev/null 2>&1 || true
        while read -r c; do
            [[ -n "$c" ]] || continue
            docker update --restart=no "$c" >/dev/null 2>&1 || true
            docker rm -f "$c" >/dev/null 2>&1 || true
        done < <(docker ps -aq --filter "name=psiphon" 2>/dev/null || true)
    fi
    USE_PSIPHON=0
    if command -v docker >/dev/null 2>&1 && docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qiE '(^|-)psiphon($|-)'; then
        warn "После отключения всё ещё видны docker-контейнеры Psiphon"
        return 1
    fi
    if ss -lntp 2>/dev/null | grep -qE ':(1080)\b'; then
        warn "Порт 1080 всё ещё слушает кто-то после отключения Psiphon"
        return 1
    fi
    return 0
}

manage_psiphon() {
    section "УПРАВЛЕНИЕ И ВЫБОР РЕЖИМА PSIPHON"
    local trace="" choice=""
    refresh_psiphon_socks
    trace="$(get_active_psiphon_trace || true)"

    if [[ -n "$trace" ]]; then
        local ip loc
        ip="$(awk -F= '$1=="ip"{print $2}' <<<"$trace" | head -n1)"
        loc="$(awk -F= '$1=="loc"{print $2}' <<<"$trace" | head -n1)"
        ok "Обнаружен активный рабочий Psiphon"
        echo "    SOCKS: $PSIPHON_SOCKS"
        echo "    Exit IP: ${ip:-unknown}"
        echo "    Country: ${loc:-unknown}"
        while true; do
            echo
            echo "Psiphon — режим для работы Gemini. Пока нормально не работает, можете протестировать."
            echo "Если Gemini не откроется, запустите скрипт ещё раз и выберите «Не использовать Psiphon»."
            echo
            echo "0) Оставить текущий рабочий Psiphon (пропустить переустановку)"
            echo "1) Переустановить / сменить регион Psiphon"
            echo "2) Не использовать Psiphon (Google/Gemini/OpenAI/Anthropic пойдут напрямую с IP сервера, мимо WARP)"
            echo
            read -rp "Выберите действие [0/1/2, Enter=0]: " choice
            choice="${choice:-0}"
            case "$choice" in
                0)
                    ok "Сохраняем текущий рабочий Psiphon"
                    USE_PSIPHON=1
                    return 0
                    ;;
                1)
                    install_psiphon_core || die "Psiphon не удалось запустить"
                    USE_PSIPHON=1
                    return 0
                    ;;
                2)
                    info "Не используем Psiphon..."
                    disable_psiphon || warn "Psiphon мог остаться в фоне — проверьте: docker ps | grep -i psiphon"
                    ok "Psiphon выключен и контейнер удалён. Google/Gemini/OpenAI/Anthropic пойдут напрямую (direct), остальное — в WARP или в блок"
                    return 0
                    ;;
                *)
                    warn "Нет пункта «${choice}». Нужно 0, 1 или 2."
                    ;;
            esac
        done
    fi

    warn "Активный рабочий Psiphon не обнаружен"
    while true; do
        echo
        echo "Psiphon — режим для работы Gemini. Пока нормально не работает, можете протестировать."
        echo "Если Gemini не откроется, запустите скрипт ещё раз и выберите «Не использовать Psiphon»."
        echo
        echo "1) Установить Psiphon"
        echo "2) Не использовать Psiphon (Google/Gemini/OpenAI/Anthropic пойдут напрямую с IP сервера, мимо WARP)"
        echo
        read -rp "Выберите действие [1/2, Enter=1]: " choice
        choice="${choice:-1}"
        case "$choice" in
            1)
                install_psiphon_core || die "Psiphon не удалось запустить"
                USE_PSIPHON=1
                return 0
                ;;
            0|2)
                info "Не используем Psiphon..."
                disable_psiphon || warn "Psiphon мог остаться в фоне — проверьте: docker ps | grep -i psiphon"
                ok "Psiphon выключен и контейнер удалён. Google/Gemini/OpenAI/Anthropic пойдут напрямую (direct), остальное — в WARP или в блок"
                return 0
                ;;
            *)
                warn "Нет пункта «${choice}». Нужно 1 или 2."
                ;;
        esac
    done
}

check_psiphon() {
    if [[ "${USE_PSIPHON:-1}" == "0" ]]; then
        info "Psiphon отключен пользователем — проверка SOCKS пропущена"
        return 0
    fi
    section "ПРОВЕРКА SOCKS PSIPHON"
    refresh_psiphon_socks
    local test ip loc
    test="$(timeout 15 curl -4fsS --proxy "socks5h://${PSIPHON_SOCKS}" --max-time 12 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)"
    [[ -n "$test" ]] || die "Psiphon SOCKS не передаёт HTTPS (${PSIPHON_SOCKS})"
    ip="$(awk -F= '$1=="ip"{print $2}' <<<"$test" | head -n1)"
    loc="$(awk -F= '$1=="loc"{print $2}' <<<"$test" | head -n1)"
    ok "Psiphon передаёт HTTPS"
    echo "    SOCKS: $PSIPHON_SOCKS"
    echo "    Exit IP: ${ip:-unknown}"
    echo "    Country: ${loc:-unknown}"
}

