    python3 - "$WG_CONF" <<'PY'
import re, sys
path = sys.argv[1]
text = open(path, "r", encoding="utf-8").read().splitlines()
lines = [ln for ln in text if not re.match(r"(?i)^\s*(PostUp|PostDown)\s*=", ln)]
insert = [
    "PostUp = /usr/local/sbin/phobos-exit-guard.sh apply",
    "PostDown = /usr/local/sbin/phobos-exit-guard.sh down",
