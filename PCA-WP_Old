    echo
    read -rp "Выберите действие [1/0, Enter=0]: " reset_choice
    reset_choice="${reset_choice:-0}"
    if [[ "$reset_choice" == "1" ]]; then
        new_pass="$(openssl rand -base64 12 | tr -d '/+=' | head -c 16)"
        python3 - "$PANEL_DIR/settings.json" "$new_pass" <<'PY'
import json, sys
path, new = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as f:
    data = json.load(f)
data["admin_pass"] = new
with open(path, "w", encoding="utf-8", newline="\n") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
        chmod 600 "$PANEL_DIR/settings.json" || true
        systemctl restart "$PANEL_UNIT"
        ok "Новый пароль панели: ${new_pass}"
    else
        ok "Пароль не менялся"
    fi
}

