install_dns_filter() {
    section "DNS БЕЗ IPv6"
    cat > /usr/local/sbin/phobos-dns-v4.py <<'PY'
#!/usr/bin/env python3
"""Отвечает на DNS клиентов туннеля. AAAA/HTTPS/SVCB — пустой NOERROR, остальное уходит в 1.1.1.1."""
import socket
import threading

LISTEN = ("0.0.0.0", 5353)
UPSTREAM = ("1.1.1.1", 53)
# AAAA, SVCB, HTTPS — иначе браузер узнаёт IPv6 и уходит мимо туннеля.
DROP_QTYPES = {28, 64, 65}
SO_MARK = 36


def warp_mark():
    try:
        for line in open("/etc/phobos-exit-warp.env", encoding="utf-8"):
            if line.startswith("WARP_OK="):
                return 255 if line.split("=", 1)[1].strip() == "1" else 0
    except OSError:
        pass
    return 0


MARK = warp_mark()


def question_end(pkt):
    i = 12
    if len(pkt) < 12:
        return None
    while i < len(pkt):
        lab = pkt[i]
        if lab == 0:
            i += 1
            break
        if lab >= 192:
            i += 2
            break
        i += 1 + lab
        if i > len(pkt):
            return None
    end = i + 4
    if end > len(pkt):
        return None
    return end


def qtype_of(pkt):
    end = question_end(pkt)
    if end is None:
        return None
    return int.from_bytes(pkt[end - 4 : end - 2], "big")


def dns_response(query, rcode):
    end = question_end(query)
    if end is None:
        return None
    hdr = bytearray(query[:12])
    flags = int.from_bytes(query[2:4], "big")
    rd = flags & 0x0100
    hdr[2:4] = (0x8000 | rd | 0x0080 | (rcode & 0x0F)).to_bytes(2, "big")
    hdr[6:12] = b"\x00" * 6
    return bytes(hdr) + query[12:end]


def forward(payload):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        if MARK:
            sock.setsockopt(socket.SOL_SOCKET, SO_MARK, MARK)
        sock.settimeout(3)
        sock.sendto(payload, UPSTREAM)
        data, _ = sock.recvfrom(4096)
        return data
    finally:
        sock.close()


def answer(payload):
    qtype = qtype_of(payload)
    if qtype in DROP_QTYPES:
        return dns_response(payload, 0)
    try:
        return forward(payload)
    except OSError:
        return dns_response(payload, 2)


def serve_udp():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(LISTEN)
    send_lock = threading.Lock()
    while True:
        data, addr = sock.recvfrom(4096)
        def reply(data=data, addr=addr):
            out = answer(data)
            if not out:
                return
            with send_lock:
                sock.sendto(out, addr)
        threading.Thread(target=reply, daemon=True).start()


def handle_tcp(conn):
    try:
        conn.settimeout(5)
        chunks = b""
        while len(chunks) < 2:
            part = conn.recv(2 - len(chunks))
            if not part:
                return
            chunks += part
        size = int.from_bytes(chunks, "big")
        if size < 12 or size > 4096:
            return
        buf = b""
        while len(buf) < size:
            part = conn.recv(size - len(buf))
            if not part:
                return
            buf += part
        out = answer(buf)
        if not out:
            return
        conn.sendall(len(out).to_bytes(2, "big") + out)
    except OSError:
        return
    finally:
        conn.close()


def serve_tcp():
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind(LISTEN)
    sock.listen(64)
    while True:
        conn, _ = sock.accept()
        threading.Thread(target=handle_tcp, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    threading.Thread(target=serve_tcp, daemon=True).start()
    serve_udp()
PY
    chmod 755 /usr/local/sbin/phobos-dns-v4.py
    cat > /etc/systemd/system/phobos-dns.service <<'EOF'
[Unit]
Description=Phobos DNS without IPv6 answers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/phobos-dns-v4.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable phobos-dns >/dev/null 2>&1 || true
    ok "DNS-фильтр: клиентам туннеля не отдаются IPv6-адреса"
}

restart_data_plane() {
    section "ЗАПУСК ВЫХОДА"
    if [[ "$WARP_OK" == "1" ]]; then
        [[ -n "$WARP_DEV" ]] || WARP_DEV="$(get_active_normal_warp || true)"
        heal_policy_routing "$WARP_DEV"
    fi
    systemctl restart phobos-dns || die "phobos-dns не запустился"
    systemctl is-active --quiet phobos-dns || die "phobos-dns не ACTIVE"
    "$GUARD" apply || die "Не удалось закрыть прямой выход wg0"
    systemctl restart "$XRAY_UNIT" || die "phobos-xray не запустился"
    local i
    for ((i = 1; i <= 20; i++)); do
        if systemctl is-active --quiet "$XRAY_UNIT"; then
            ok "phobos-xray ACTIVE"
            break
        fi
        sleep 1
    done
    systemctl is-active --quiet "$XRAY_UNIT" || die "phobos-xray не ACTIVE"

    systemctl restart wg-quick@wg0
    local unit
    for unit in $(systemctl list-units 'wg-obfuscator-*' --no-legend --plain --type=service 2>/dev/null | awk '{print $1}'); do
        systemctl restart "$unit" >/dev/null 2>&1 || true
    done
    "$GUARD" apply || die "Повторное закрытие выхода wg0 не удалось"
    if [[ "$WARP_OK" == "1" ]]; then
        heal_policy_routing "$WARP_DEV"
    fi
    if command -v conntrack >/dev/null 2>&1; then
        conntrack -D -s "$(vpn_net)" >/dev/null 2>&1 || true
    fi
    ok "wg0 и обфускатор перезапущены, старые NAT-сессии сброшены"
}

verify_exit_policy() {
    section "ПРОВЕРКА ОТСУТСТВИЯ ПРЯМОГО ВЫХОДА"
    local net pub rule
    net="$(vpn_net)"
    pub="$(public_iface || true)"
    iptables -C FORWARD -i wg0 -j PHOBOS_FWD || die "Нет запрета FORWARD с wg0"
    iptables -t mangle -C PREROUTING -i wg0 -j PHOBOS_PRE || die "Нет TPROXY с wg0"
    local listeners
    listeners="$(ss -lntu 2>/dev/null || true)"
    grep -Eq "127\.0\.0\.1:${TPROXY_PORT}([^0-9]|$)" <<<"$listeners" || die "Xray не слушает 127.0.0.1:${TPROXY_PORT}"
    systemctl is-active --quiet phobos-dns || die "phobos-dns не ACTIVE"
    grep -Eq ":${DNS_FILTER_PORT}([^0-9]|$)" <<<"$listeners" || die "DNS-фильтр не слушает ${DNS_FILTER_PORT}"
    iptables -t nat -C PREROUTING -i wg0 -j PHOBOS_DNS || die "Нет перехвата DNS с wg0"

    while read -r rule; do
        [[ "$rule" == *" -j MASQUERADE"* || "$rule" == *" -j SNAT"* ]] || continue
        if [[ "$rule" != *" -s "* && "$rule" == *" -j MASQUERADE"* ]]; then
            die "Остался открытый MASQUERADE: $rule"
        fi
        if [[ "$rule" == *" -s ${net} "* ]]; then
            die "Остался NAT сети клиентов: $rule"
        fi
    done < <(iptables -t nat -S POSTROUTING)

    [[ -n "$pub" && "$pub" != "warp" ]] || die "Default route смотрит в WARP (${pub:-empty})"

    if [[ "$WARP_OK" == "1" ]]; then
        if ! has_warp_fwmark_rule; then
            warn "ip rule fwmark ${WARP_MARK} отсутствует — восстанавливаем"
            heal_policy_routing "$WARP_DEV"
        fi
        has_warp_fwmark_rule || {
            echo "Текущие ip rule:"
            ip rule show || true
            die "Нет ip rule fwmark ${WARP_MARK}"
        }
        ip route show table "$WARP_TABLE" | grep -q "^default" || die "В таблице ${WARP_TABLE} нет default"
        local wdev
        wdev="$(ip route show table "$WARP_TABLE" | awk '/^default/ {for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}')"
        [[ "$wdev" == "warp" ]] || die "Таблица WARP смотрит не в туннель ($wdev)"
    fi

    if [[ "$USE_PSIPHON" == "1" ]]; then
        refresh_psiphon_socks
        get_active_psiphon_trace >/dev/null || die "Psiphon выбран, но SOCKS не отвечает"
        [[ "$PSIPHON_SOCKS" != 0.0.0.0:* && "$PSIPHON_SOCKS" != ":"* ]] || die "Psiphon слушает слишком широко"
        ok "Psiphon активен (${PSIPHON_SOCKS})"
    else
        if command -v docker >/dev/null 2>&1; then
            if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qiE '(^|-)psiphon($|-)'; then
                warn "Psiphon отключён в политике, но контейнер ещё есть — удаляем"
                disable_psiphon || true
            fi
            if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qiE '(^|-)psiphon($|-)'; then
                die "Psiphon отключён, но контейнер всё ещё на сервере"
            fi
        fi
        ok "Psiphon не используется и контейнер отсутствует"
    fi

    ok "Прямой выход клиентов закрыт"
    echo "    VPN сеть     : $net"
    echo "    Публичный NIC: $pub"
    echo "    TPROXY       : 127.0.0.1:${TPROXY_PORT}"
    echo "    Catch-all    : $([[ "$WARP_OK" == 1 ]] && echo "WARP fwmark ${WARP_MARK}" || echo "BLACKHOLE")"
}

