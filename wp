#!/usr/bin/env bash
# Прикрывашка: ищет на VPS LucX и PCA Phobos и запускает нужный скрипт прикрытия.
set -Eeuo pipefail
LUX_URL="https://raw.githubusercontent.com/miha75vu-bit/Flashkeen/main/Lux-WP"
PCA_URL="https://raw.githubusercontent.com/miha75vu-bit/Flashkeen/main/PCA-WP"
WORKDIR="/root/warp-psiphon-setup"
if [[ ! -t 0 ]]; then
    echo "Так меню не откроется. Запустите:"
    echo "bash <(curl -fsSL https://raw.githubusercontent.com/miha75vu-bit/Flashkeen/main/wp)"
    exit 1
fi
die() {
    echo "[ОШИБКА] $*" >&2
    exit 1
}
has_lux() {
    [[ -x /usr/local/x-ui/x-ui ]] && return 0
    systemctl cat x-ui >/dev/null 2>&1
}
has_phobos() {
    [[ -f /opt/phobos-panel/app.py ]] && return 0
    systemctl cat phobos-panel >/dev/null 2>&1
}
explain() {
    cat <<'EOF'
Прикрывашка
Прикрываем выход VPN-панели: трафик клиентов не уходит в интернет напрямую с IP этого сервера.
Зачем. Без прикрытия сайты видят адрес VPS, а на самом сервере трафик можно разобрать. Многие бесплатные и российские VPN-приложения сами записывают, какие сайты вы открываете, и отдают это своим серверам. Это ещё одна точка слежки, а не защита.
Что делает прикрытие. Обычные сайты уходят в WARP (Cloudflare), не с IP сервера. Российские сайты и шпионские сервисы (Яндекс, VK и похожие) обрываются. Google и Gemini можно пустить через Psiphon — это отдельный пункт в меню скрипта, его можно не включать.

Рекомендую попробовать для начала PCA Phobos и толкьо если он не работает - ставить LUX. И использовать не более одного протокола на сервере, так вы уменьшаете вероятность детекта.
EOF
}
run_cover() {
    local title="$1" url="$2" file="$3" dest
    dest="${WORKDIR}/${file}"
    mkdir -p "$WORKDIR"
    echo "Скачиваем ${title}..."
    curl -fL --connect-timeout 20 --max-time 180 -o "$dest" "$url" || die "Не удалось скачать ${title}"
    sed -i 's/\r$//' "$dest"
    chmod +x "$dest"
    echo "Запускаем ${title}"
    echo
    bash "$dest"
}
ask_yes() {
    local ans
    read -rp "$1 [Д/н, Enter=Д]: " ans || true
    case "${ans:-Д}" in
        н|Н|n|N|no|No|нет|Нет) return 1 ;;
        *) return 0 ;;
    esac
}
main() {
    local lux=0 phobos=0 first=""
    explain
    has_lux && lux=1 || true
    has_phobos && phobos=1 || true
    if [[ "$lux" == "1" && "$phobos" == "1" ]]; then
        echo "На сервере стоят оба: LucX и PCA Phobos."
        echo "Прикроем по очереди. Второй запустится только если вы согласитесь."
        echo
        echo "1) Сначала LucX"
        echo "2) Сначала PCA Phobos"
        echo
        read -rp "Кого прикрыть сейчас [1/2, Enter=1]: " first || true
        first="${first:-1}"
        case "$first" in
            1)
                echo "Прикрываем LucX: клиенты панели x-ui не выходят напрямую с IP сервера."
                echo
                run_cover "Lux-WP" "$LUX_URL" "Lux-WP" || true
                echo
                if ask_yes "Прикрыть ещё PCA Phobos?"; then
                    echo "Прикрываем PCA Phobos: телефоны и роутеры на wg0 не ходят мимо WARP."
                    echo
                    run_cover "PCA-WP" "$PCA_URL" "PCA-WP"
                else
                    echo "PCA Phobos оставлен без прикрытия."
                fi
                ;;
            2)
                echo "Прикрываем PCA Phobos: телефоны и роутеры на wg0 не ходят мимо WARP."
                echo
                run_cover "PCA-WP" "$PCA_URL" "PCA-WP" || true
                echo
                if ask_yes "Прикрыть ещё LucX?"; then
                    echo "Прикрываем LucX: клиенты панели x-ui не выходят напрямую с IP сервера."
                    echo
                    run_cover "Lux-WP" "$LUX_URL" "Lux-WP"
                else
                    echo "LucX оставлен без прикрытия."
                fi
                ;;
            *)
                die "Неизвестный пункт."
                ;;
        esac
        return 0
    fi
    if [[ "$lux" == "1" ]]; then
        echo "На сервере LucX. PCA Phobos нет."
        echo "Прикрываем LucX: клиенты панели x-ui не выходят напрямую с IP сервера."
        echo
        run_cover "Lux-WP" "$LUX_URL" "Lux-WP"
        return 0
    fi
    if [[ "$phobos" == "1" ]]; then
        echo "На сервере PCA Phobos. LucX нет."
        echo "Прикрываем PCA Phobos: телефоны и роутеры на wg0 не ходят мимо WARP."
        echo
        run_cover "PCA-WP" "$PCA_URL" "PCA-WP"
        return 0
    fi
    echo "Ни LucX, ни PCA Phobos на сервере не найдены."
    echo "Скрипт прикрытия сам поставит выбранную панель."
    echo
    echo "1) Прикрыть LucX"
    echo "2) Прикрыть PCA Phobos"
    echo "0) Выход"
    echo
    read -rp "Выберите [1/2/0, Enter=0]: " first || true
    first="${first:-0}"
    case "$first" in
        1)
            echo "Прикрываем LucX: клиенты панели x-ui не выходят напрямую с IP сервера."
            echo
            run_cover "Lux-WP" "$LUX_URL" "Lux-WP"
            ;;
        2)
            echo "Прикрываем PCA Phobos: телефоны и роутеры на wg0 не ходят мимо WARP."
            echo
            run_cover "PCA-WP" "$PCA_URL" "PCA-WP"
            ;;
        0) echo "Выход." ;;
        *) die "Неизвестный пункт." ;;
    esac
}
main "$@"
