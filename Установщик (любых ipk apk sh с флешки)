mkdir -p /opt/bin

cat > /opt/bin/install <<'INSTALL_SCRIPT'
#!/bin/sh

while true; do
    echo
    printf "\033[1m          УСТАНОВЩИК\033[0m\n\n"

    printf "Введите название устанавливаемого скрипта или приложения с расширением ipk, apk, sh (0 - выход):\n" > /dev/tty

    IFS= read -r filename < /dev/tty || exit 0

    case "$filename" in
        0)
            echo "Выход из установщика."
            exit 0
            ;;
    esac

    [ -n "$filename" ] || {
        echo "Название не указано!"
        continue
    }

    # Удаляем расширение, если оно указано
    case "$filename" in
        *.ipk|*.apk|*.sh)
            filename="${filename%.*}"
            ;;
    esac

    found="/tmp/install_files.$$"
    : > "$found"

    # ЭТАП 1: поиск полного совпадения
    for d in /storage /mnt /tmp/mnt /media; do
        [ -d "$d" ] || continue

        find "$d" -type f \( \
            -name "$filename.ipk" -o \
            -name "$filename.apk" -o \
            -name "$filename.sh" \
        \) 2>/dev/null >> "$found"
    done

    sort -u "$found" -o "$found"

    # ЭТАП 2: поиск по первому слову
    if [ ! -s "$found" ]; then
        first_word=${filename%% *}

        echo "Точное совпадение не найдено."
        echo "Поиск по первому слову: $first_word"

        for d in /storage /mnt /tmp/mnt /media; do
            [ -d "$d" ] || continue

            find "$d" -type f \( \
                -name "$first_word"*.ipk -o \
                -name "$first_word"*.apk -o \
                -name "$first_word"*.sh \
            \) 2>/dev/null >> "$found"
        done

        sort -u "$found" -o "$found"
    fi

    if [ ! -s "$found" ]; then
        echo "Файлы не найдены!"
        rm -f "$found"
        continue
    fi

    count=$(wc -l < "$found" | tr -d ' ')

    echo
    echo "========== НАЙДЕННЫЕ ФАЙЛЫ =========="

    i=0
    while IFS= read -r line; do
        i=$((i + 1))
        printf "%s - %s\n" "$i" "$line"
    done < "$found"

    echo "-------------------------------------"
    echo "0 - Выход"
    echo "====================================="

    printf "Введите номер файла: " > /dev/tty
    IFS= read -r choice < /dev/tty || {
        rm -f "$found"
        exit 0
    }

    case "$choice" in
        0)
            rm -f "$found"
            echo "Выход из установщика."
            exit 0
            ;;
        *[!0-9]*|'')
            echo "Неверный номер!"
            rm -f "$found"
            continue
            ;;
    esac

    if [ "$choice" -gt "$count" ] || [ "$choice" -lt 1 ]; then
        echo "Такого номера нет!"
        rm -f "$found"
        continue
    fi

    file=$(sed -n "${choice}p" "$found")
    rm -f "$found"

    [ -f "$file" ] || {
        echo "Файл не существует!"
        continue
    }

    echo
    echo "Выбран файл: $file"

    chmod +x "$file"

    case "$file" in
        *.ipk|*.apk)
            echo "Установка пакета..."
            opkg install "$file"
            ;;
        *.sh)
            echo "Запуск скрипта..."
            sh "$file"
            ;;
    esac

    echo
    echo "Операция завершена."

done
INSTALL_SCRIPT

chmod +x /opt/bin/install

case ":$PATH:" in
    *:/opt/bin:*) ;;
    *) export PATH="/opt/bin:$PATH" ;;
esac

echo "Установщик сохранён и обновлён."
echo "Запуск..."
/opt/bin/install
